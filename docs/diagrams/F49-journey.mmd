flowchart TD
    A[Menu Principal] -->|"Click CAMPANHA"| B[Mapa do Mundo]
    B --> C{Nivel desbloqueado?}
    C -->|Nao| D[No com cadeado - nao clicavel]
    D --> B
    C -->|Sim| E[Click no nivel]
    E --> F[Carrega JSON do nivel]
    F --> G[GameScene3D inicia em modo level]

    G --> H[Mel spawna no ponto de inicio]
    H --> I[Jogador joga a fase]

    I --> J{Mel encontra placa?}
    J -->|Sim| K[Balao com texto aparece]
    K --> L[Mel sai de perto]
    L --> I
    J -->|Nao| I

    I --> M{Mel encontra osso?}
    M -->|Sim| N[Osso coletado - HUD atualiza X/3]
    N --> I
    M -->|Nao| I

    I --> O{Mel encontra checkpoint?}
    O -->|Sim| P[Checkpoint ativado - casinha brilha]
    P --> I
    O -->|Nao| I

    I --> Q{Mel morre?}
    Q -->|Sim - caiu ou lava| R[Respawn no ultimo checkpoint]
    R -->|Mortes +1 - 3 coracoes| I
    Q -->|Nao| I

    I --> S{Mel chega no Goal?}
    S -->|Sim| T[Animacao jump_on_owner 1.5s]
    T --> U[Tela de Resultado]

    U --> V["Mostra: estrelas + moedas + tempo + mortes + ossos"]
    V --> W{Escolha do jogador}

    W -->|PROXIMA FASE| X{Ultima fase?}
    X -->|Nao| F2[Carrega proximo nivel]
    F2 --> G
    X -->|Sim| Y[Volta ao Mapa do Mundo]

    W -->|REPETIR| Z[Reinicia mesmo nivel]
    Z --> G

    W -->|MAPA| Y
    Y --> B2[Mapa atualizado com estrelas e ossos]
    B2 --> B

    W -->|MENU| A

    %% Progress sync
    U -.->|Salva progresso| LS[(localStorage)]
    LS -.->|useProgressSync| BE[(Backend)]

    style A fill:#4a4a8a,color:#fff
    style B fill:#4a8a4a,color:#fff
    style G fill:#333,color:#fff
    style U fill:#FFD700,color:#333
    style K fill:#A0522D,color:#fff
    style N fill:#F5F5DC,color:#333
    style P fill:#D2691E,color:#fff
