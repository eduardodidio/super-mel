    end

    subgraph TransitionFixes["Transition Fixes (F60)"]
        TR["Theme reset on MENU/MAPA"]
        SC["Campaign state cleanup"]
        CB["currentBiome reset"]
    end

    subgraph PhysicsFixes["Physics Fixes (F60)"]
        LF["Leaf: solid=true (restored)"]
        BN["Bones repositioned (1-5, 1-8)"]
        SG["Sign text: voar->pulo duplo"]
    end

    style Game3D fill:#2a4858,color:#fff
    style TouchControls fill:#4a6858,color:#fff
    style SceneContent fill:#3a5868,color:#fff
    style MobileFixes fill:#5a4858,color:#fff
