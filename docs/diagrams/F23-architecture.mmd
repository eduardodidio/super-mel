        EFF["EffectSprite.tsx<br/>Procedural effects"]
    end

    subgraph UI["UI Layer"]
        HUD["HUD3D.tsx<br/>Portrait + Hearts + Score"]
    end

    PNGS --> SA
    MANIFEST --> SA
    SA --> MEL
    ASM --> MEL
